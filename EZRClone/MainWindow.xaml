<Window x:Class="EZRClone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EZRClone.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
        Title="EZRClone" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="#6B4F1D"
                BorderBrush="#D6A84D"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAppWarningVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding AppWarningMessage}"
                           FontWeight="SemiBold"
                           Foreground="White"
                           TextWrapping="Wrap" />
                <Button Grid.Column="1"
                        Content="Open Settings"
                        Command="{Binding OpenAppWarningTargetCommand}"
                        Margin="12,0,0,0"
                        Padding="12,4" />
            </Grid>
        </Border>

        <!-- Navigation Sidebar -->
        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SurfaceBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding VersionText}"
                           FontSize="9" Foreground="{DynamicResource ForegroundSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <RadioButton DockPanel.Dock="Bottom" Style="{DynamicResource NavButtonStyle}"
                             Content="&#xE713;"
                             Tag="App"
                             Command="{Binding NavigateCommand}"
                             CommandParameter="Settings" />
                <StackPanel VerticalAlignment="Top">
                    <RadioButton Style="{DynamicResource NavButtonStyle}"
                                 Content="&#xE8B7;"
                                 Tag="Remotes"
                                 IsChecked="True"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Config" />
                    <RadioButton Style="{DynamicResource NavButtonStyle}"
                                 Content="&#xE895;"
                                 Tag="Jobs"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Jobs" />
                    <RadioButton Style="{DynamicResource NavButtonStyle}"
                                 Content="&#xED25;"
                                 Tag="Browse"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Browse" />
                    <RadioButton Style="{DynamicResource NavButtonStyle}"
                                 Content="&#xE721;"
                                 Tag="Search"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Search" />
                    <RadioButton Style="{DynamicResource NavButtonStyle}"
                                 Content="&#xE9D5;"
                                 Tag="Log"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Log" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content Area -->
        <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentView}" Margin="0" />
    </Grid>
</Window>
