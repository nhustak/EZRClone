<UserControl x:Class="EZRClone.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EZRClone.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             Loaded="OnLoaded"
             Background="{DynamicResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" MaxWidth="600" HorizontalAlignment="Left">
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Application Settings" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundBrush}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Test Settings" Margin="0,0,10,0"
                        Command="{Binding TestSettingsCommand}" HorizontalAlignment="Left" />
                <Button Content="Save Settings" Style="{DynamicResource AccentButton}"
                        Command="{Binding SaveCommand}" HorizontalAlignment="Left" />
            </StackPanel>
        </Grid>
        <Border Background="{DynamicResource SurfaceBrush}" Padding="10" Margin="0,0,0,20" CornerRadius="3">
            <TextBlock Text="Use this screen to set the rclone executable path and the single rclone.conf file that EZRClone should use for tests, browse, search, and jobs."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource ForegroundSecondaryBrush}" />
        </Border>

        <!-- RClone exe path -->
        <TextBlock Text="RClone Executable Path:" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6" />
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding RCloneExePath, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6,4" />
            <Button Grid.Column="1" Content="Browse..."
                    Click="OnBrowseExe" Margin="8,0,0,0" />
        </Grid>

        <!-- Validation message -->
        <TextBlock Margin="0,0,0,20" FontSize="12">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsValid}" Value="True">
                            <Setter Property="Foreground" Value="#4EC9B0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
            <Run Text="{Binding ValidationMessage, Mode=OneWay}" />
        </TextBlock>

        <TextBlock Text="{Binding ExecutableValidationMessage}" FontSize="11"
                   Foreground="{DynamicResource ForegroundSecondaryBrush}" Margin="0,0,0,12" />

        <!-- Config file path -->
        <TextBlock Text="RClone Config File Path:" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6" />
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding RCloneConfigPath, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6,4" />
            <Button Grid.Column="1" Content="Override..."
                    Click="OnBrowseConfig" Margin="8,0,0,0" />
        </Grid>
        <TextBlock Text="This is the config file used by all live rclone commands in the app. Leave it blank and Save Settings to auto-detect and store the real path."
                   Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11"
                   Margin="0,0,0,24" />
        <TextBlock Text="{Binding ConfigValidationMessage}" FontSize="11"
                   Foreground="{DynamicResource ForegroundSecondaryBrush}" Margin="0,0,0,12" />

        <!-- Default download path -->
        <TextBlock Text="Default Download Path:" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6" />
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding DefaultDownloadPath, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6,4" />
            <Button Grid.Column="1" Content="Browse..."
                    Click="OnBrowseDownloadPath" Margin="8,0,0,0" />
        </Grid>
        <TextBlock Text="Default folder for downloads from Browse. You can override per download."
                   Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11"
                   Margin="0,0,0,16" />

        <TextBlock Text="Global RClone CLI Options:" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6" />
        <TextBlock Text="Each operation can have its own default rclone flags. Downloads still let you override these at run time."
                   Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16" />

        <Border Background="{DynamicResource SurfaceBrush}" Padding="12" Margin="0,0,0,16" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="Connection Speed Preset"
                           Foreground="{DynamicResource ForegroundBrush}"
                           Margin="0,0,0,6" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding ConnectionPresets}"
                              SelectedItem="{Binding SelectedConnectionPreset}"
                              DisplayMemberPath="DisplayName"
                              Padding="6,4" />
                    <Button Grid.Column="1"
                            Content="Apply Preset"
                            Margin="10,0,0,0"
                            Padding="14,6"
                            Command="{Binding ApplyConnectionPresetCommand}" />
                </Grid>
                <TextBlock Text="{Binding SelectedConnectionPreset.Summary}"
                           Foreground="{DynamicResource ForegroundSecondaryBrush}"
                           FontSize="11"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding OperationEditors}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Expander Header="{Binding DisplayName}"
                              IsExpanded="False"
                              Margin="0,0,0,10"
                              Foreground="{DynamicResource ForegroundBrush}">
                        <Border Margin="0,8,0,0"
                                Padding="12"
                                Background="{DynamicResource SurfaceBrush}"
                                CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="{Binding Description}"
                                           Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12" />

                                <UniformGrid Columns="2" Margin="0,0,0,12">
                                    <StackPanel Margin="0,0,10,8">
                                        <TextBlock Text="Transfers" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Transfers, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Checkers" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Checkers, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,8">
                                        <TextBlock Text="Retries" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Retries, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Low-Level Retries" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding LowLevelRetries, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,8">
                                        <TextBlock Text="Timeout (ms)" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding TimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Multi-Thread Streams" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding MultiThreadStreams, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Text="Bandwidth Limit" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding BandwidthLimit, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6,4"
                                         Margin="0,0,0,10" />

                                <CheckBox Content="Enable rclone progress output for this operation"
                                          IsChecked="{Binding UseProgress}"
                                          Foreground="{DynamicResource ForegroundBrush}"
                                          Margin="0,0,0,10" />

                                <TextBlock Text="Extra Flags" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding ExtraFlagsText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6,4"
                                         Margin="0,0,0,4" />
                                <TextBlock Text="Example: --multi-thread-streams 4 --ignore-existing --bwlimit 50M"
                                           Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Expander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Always get directory info -->
        <CheckBox Content="Always get directory info when browsing"
                  IsChecked="{Binding AlwaysGetDirectoryInfo}"
                  Foreground="{DynamicResource ForegroundBrush}"
                  Margin="0,0,0,6" />
        <TextBlock Text="Automatically fetch recursive file counts and sizes for directories. Can be slow on large remotes."
                   Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,0,0,24" />

        <CheckBox Content="Default delete jobs to dry run"
                  IsChecked="{Binding DefaultDeleteDryRun}"
                  Foreground="{DynamicResource ForegroundBrush}"
                  Margin="0,0,0,6" />
        <TextBlock Text="{Binding RemoteValidationMessage}"
                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                   FontSize="11"
                   Margin="0,0,0,24" />

        <!-- Save -->
        <StackPanel Orientation="Horizontal">
            <Button Content="Validate" Margin="0,0,10,0"
                    Command="{Binding ValidateCommand}" HorizontalAlignment="Left" />
            <Button Content="Test Settings" Margin="0,0,10,0"
                    Command="{Binding TestSettingsCommand}" HorizontalAlignment="Left" />
            <Button Content="Save Settings" Style="{DynamicResource AccentButton}"
                    Command="{Binding SaveCommand}" HorizontalAlignment="Left" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</UserControl>
